rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function validPublishedSnapshot() {
      return request.resource.data.keys().hasOnly([
          'schemaVersion', 'publishedAt', 'notices', 'resources', 'churches', 'settings'
        ])
        && request.resource.data.schemaVersion == 2
        && request.resource.data.publishedAt is string
        && request.resource.data.notices is list
        && request.resource.data.notices.size() <= 100
        && request.resource.data.resources is list
        && request.resource.data.resources.size() <= 300
        && request.resource.data.churches is list
        && request.resource.data.churches.size() <= 200
        && request.resource.data.settings is map
        && request.resource.data.settings.siteName is string;
    }

    function optionalString(data, field) {
      return !(field in data) || data[field] is string;
    }

    function optionalHttps(data, field) {
      return !(field in data) || (data[field] is string && data[field].matches('https://.*'));
    }

    function validResource() {
      let data = request.resource.data;
      return data.keys().hasOnly(['section', 'title', 'subtitle', 'url', 'thumbnailUrl', 'label', 'order'])
        && data.keys().hasAll(['section', 'title', 'url', 'order'])
        && data.section in ['sermon', 'books', 'healing', 'prayer', 'praise', 'bible', 'links', 'truth']
        && data.title is string && data.title.size() > 0 && data.title.size() <= 150
        && data.url is string && data.url.matches('https://.*')
        && data.order is number
        && optionalString(data, 'subtitle') && optionalString(data, 'label')
        && optionalHttps(data, 'thumbnailUrl');
    }

    function validNotice() {
      let data = request.resource.data;
      return data.keys().hasOnly(['title', 'body', 'date', 'imageUrls', 'linkUrl', 'linkText', 'order'])
        && data.keys().hasAll(['title', 'order'])
        && data.title is string && data.title.size() > 0 && data.title.size() <= 150
        && data.order is number
        && optionalString(data, 'body') && optionalString(data, 'date') && optionalString(data, 'linkText')
        && optionalHttps(data, 'linkUrl')
        && (!('imageUrls' in data) || (data.imageUrls is list && data.imageUrls.size() <= 10));
    }

    function validChurch() {
      let data = request.resource.data;
      return data.keys().hasOnly(['name', 'region', 'address', 'phone', 'url', 'order'])
        && data.keys().hasAll(['name', 'region', 'order'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.region is string && data.region.size() > 0 && data.region.size() <= 30
        && data.order is number
        && optionalString(data, 'address') && optionalString(data, 'phone')
        && optionalHttps(data, 'url');
    }

    function validSettings() {
      let data = request.resource.data;
      return data.keys().hasOnly(['siteName', 'supportUrl', 'inquiryUrl'])
        && data.siteName is string && data.siteName.size() > 0 && data.siteName.size() <= 100
        && optionalHttps(data, 'supportUrl') && optionalHttps(data, 'inquiryUrl');
    }

    match /published/{snapshotId} {
      allow read: if snapshotId == 'current';
      allow create, update: if isAdmin() && snapshotId == 'current' && validPublishedSnapshot();
      allow delete: if false;
    }

    match /resources/{resourceId} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin() && validResource();
    }

    match /notices/{noticeId} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin() && validNotice();
    }

    match /churches/{churchId} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin() && validChurch();
    }

    match /siteSettings/{settingsId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && settingsId == 'main' && validSettings();
      allow delete: if false;
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
